APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3000

# Base PostgreSQL creada previamente con el nombre "losa".
DATABASE_URL=postgresql+asyncpg://postgres:CAMBIA_ESTA_CLAVE@localhost:5432/losa

JWT_SECRET=cambia_por_una_clave_segura_de_al_menos_32_caracteres
JWT_REFRESH_SECRET=cambia_por_otra_clave_segura_de_al_menos_32_caracteres
# Opcional. Usa la misma clave independiente en FastAPI y el proceso de entrenamiento.
# ML_ARTIFACT_SECRET=una_clave_independiente_de_al_menos_32_caracteres
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175"]
UNHEVAL_API_URL=http://localhost:3001/api
# Para un destino consolidado de Supabase se configuran estos valores en .env.
# POSTGRES_SCHEMA=sirlod
# POSTGRES_TLS_VERIFY=true
# POSTGRES_TLS_CA_CERT=C:/ruta/ca-de-supabase.pem
# POSTGRES_TLS_CA_PEM=contenido PEM del certificado CA para hosting
# POSTGRES_POOL_SIZE=2
# POSTGRES_MAX_OVERFLOW=1
# UNHEVAL_SOURCE=postgresql

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_BUCKET=
S3_KEY_PREFIX=documentos
S3_IMAGE_KEY_PREFIX=imagenes
S3_DOCUMENT_KEY_PREFIX=documentos
S3_REPORT_KEY_PREFIX=reportes
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_EXPIRES_SECONDS=900
# El proveedor alternativo utiliza un bucket privado y una clave de servidor.
# STORAGE_PROVIDER=supabase
# SUPABASE_STORAGE_URL=https://REFERENCIA.supabase.co
# SUPABASE_STORAGE_SECRET_KEY=
# SUPABASE_STORAGE_BUCKET=sirlod

MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_LOG_FILE=mail.log

RENIEC_API_TOKEN=
RENIEC_API_URL=

# Chatbot: deepseek, gemini u openai
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# Clave exclusiva de Reportes. Requerida para usar DeepSeek en el entorno de practica.
REPORT_DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Revisión de Documentos PDF: OpenAI (o gemini)
DOCUMENT_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DOCUMENT_AI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

DOCUMENT_AI_MIN_CONFIDENCE=0.85
